{
  "name": "dropbox-mcp",
  "version": "0.5.0",
  "description": "MCP server exposing Dropbox file recovery, search, download, upload, move, and delete operations to LLM agents.",
  "type": "module",
  "packageManager": "bun@1.4.0",
  "engines": {
    "node": ">=24",
    "bun": ">=1.4.0"
  },
  "main": "./dist/index.js",
  "bin": {
    "dropbox-mcp": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "watch": "tsc --watch",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "bundle": "bun scripts/bundle.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "dropbox": "^10.45.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.0.0",
    "@types/node": "^26",
    "@vitest/coverage-v8": "^4.1.10",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
